// Project configuration for Aegis. Agent definitions live in
// .opencode/agents/*.md; this file selects the main agent and names the default
// model. Reasoning variants are pinned per agent because the root default does
// not retain a #variant.
{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "default_agent": "aegis-main",
  "permissions": [
    {
      "action": "experimental_image_generate",
      "resource": "*",
      "effect": "deny"
    }
  ]
}
