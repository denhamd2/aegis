        <item name="android:windowBackground">@color/aegis_amoled_black</item>
        <item name="android:statusBarColor">@color/aegis_amoled_black</item>
        <item name="android:navigationBarColor">@color/aegis_amoled_black</item>
    </style>
</resources>
