<?xml version="1.0" encoding="utf-8"?>
<!-- allowBackup is false, but this deny-all is kept as defense-in-depth
     against OEM backup mechanisms that don't honor allowBackup. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapability="true">
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
