+            baseline = _curve_snapshot(original)
+            bpy.data.actions.remove(original)
+            action = author(poser, arm, name, CLIPS[name])
+            _guard_running_release_curves(action, baseline)
+        else:
+            author(poser, arm, name, CLIPS[name])
