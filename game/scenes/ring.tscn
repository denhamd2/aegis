[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_crowd"]
; A crowd bank, not a wall. The void measurement that opened this slice was
; not "the background is too dark" -- the reference frame's crowd is dark
; too (relative luminance 0.014) -- it was that our background had a
; standard deviation of 0.000 across the entire upper third of frame:
; nothing was modelled there at all. Dark geometry with high-frequency
; variance is what a crowd reads as at match-camera distance, and it is
; generated noise rather than any captured image (IP guardrail).
albedo_color = Color(0.34, 0.33, 0.38, 1)
albedo_texture = SubResource("NoiseTexture2D_crowd")
uv1_scale = Vector3(9, 3, 1)
roughness = 0.95
; House light on the crowd, carried by the material rather than by lights
; aimed at the stands. A real fill rig out there would also spill onto the
; mat, and ring lighting is a different slice's variable -- this lifts the
; stands off the Environment's background value without touching how the
; ring itself is lit. Measured: without it the arena shell rendered at
; roughly the background's own luminance and the void fraction barely moved.
emission_enabled = true
emission = Color(0.19, 0.18, 0.22, 1)
emission_energy_multiplier = 0.55

