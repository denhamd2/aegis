position = Vector3(0, -0.55, -3.15)
rotation = Vector3(0, 3.14159, 0)

[node name="ApronEast" type="MeshInstance3D" parent="Apron"]
mesh = SubResource("QuadMesh_apron")
surface_material_override/0 = SubResource("StandardMaterial3D_apron")
position = Vector3(3.15, -0.55, 0)
rotation = Vector3(0, 1.5708, 0)

; -1.5708, not +1.5708. Both East and West carried +1.5708 when these were
; boxes, which was harmless because a box draws all six faces. A quad has one,
; so West would have faced into the ring and rendered as a hole from outside.
[node name="ApronWest" type="MeshInstance3D" parent="Apron"]
mesh = SubResource("QuadMesh_apron")
surface_material_override/0 = SubResource("StandardMaterial3D_apron")
position = Vector3(-3.15, -0.55, 0)
rotation = Vector3(0, -1.5708, 0)

