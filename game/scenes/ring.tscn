[gd_scene load_steps=15 format=3]

[ext_resource type="Texture2D" path="res://assets/environment/materials/Fabric063_Color.jpg" id="1_apron_color"]
[ext_resource type="Texture2D" path="res://assets/environment/materials/Fabric063_Roughness.jpg" id="2_apron_rough"]

[sub_resource type="BoxShape3D" id="BoxShape3D_floor"]
size = Vector3(6, 0.2, 6)

[sub_resource type="BoxMesh" id="BoxMesh_floor"]
size = Vector3(6, 0.2, 6)

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_floor"]
; Measured relationship, not a colour preference: on
; gauntlet/refs/frames/wide_standoff_broadcast_angle.jpg the mat renders at
; relative luminance 0.46 and both wrestlers sit 0.24-0.31 below it (see
; tools/refs/measure_frame.py and VISUAL_BAR.md). Holding the mat's value
; while tinting it is what gives the darkened attire something to read
; against; a neutral grey of the same value did the same job for silhouette
; but read as concrete rather than canvas.
albedo_color = Color(0.6, 0.7, 0.82, 1)
roughness = 0.85

[sub_resource type="BoxMesh" id="BoxMesh_rope"]
size = Vector3(6.2, 0.05, 0.05)

[sub_resource type="BoxShape3D" id="BoxShape3D_rope"]
size = Vector3(6.2, 8.0, 0.3)

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_rope"]
; All four sides, all three heights, one white rope. These were red/white/
; blue -- a boxing convention, not a wrestling one. Every rope in every
; reference frame is white (clearest in the near-rope foreground of
; gauntlet/refs/frames/wide_standoff_broadcast_angle.jpg), and white is also
; what makes the ropes read as a framing element against the mat rather than
; as three coloured stripes competing with the wrestlers' colourways for
; attention.
albedo_color = Color(0.93, 0.93, 0.91, 1)
roughness = 0.6

[sub_resource type="CylinderMesh" id="CylinderMesh_post"]
top_radius = 0.08
bottom_radius = 0.1
height = 1.5
radial_segments = 12

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_post"]
albedo_color = Color(0.12, 0.12, 0.14, 1)
metallic = 0.3
roughness = 0.5

[sub_resource type="BoxMesh" id="BoxMesh_pad"]
size = Vector3(0.28, 0.5, 0.28)

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_pad"]
albedo_color = Color(0.1, 0.15, 0.7, 1)
roughness = 0.9

[sub_resource type="BoxMesh" id="BoxMesh_apron"]
size = Vector3(6.6, 0.9, 0.1)

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_apron"]
; The skirt was already modelled -- four boxes have hung here since the first
; art pass -- but at albedo 0.08 against an arena floor of 0.03 it rendered as
; more void, which is why the slice's gap line said "no ring skirt" about
; geometry that was present. The fix is value separation, not more geometry:
; the skirt now sits between the mat above it and the arena floor below it
; instead of merging into one of them, and carries the ring's own blue rather
; than being another neutral dark surface.
;
; The fabric is CC0 (assets/environment/CREDITS.md). It is here for variance,
; not for value: albedo_color still holds the luminance, and the texture
; multiplies into it, so the relationships measure_frame.py reads are the ones
; set here. Material believability is UNJUDGED under llvmpipe either way.
albedo_color = Color(0.13, 0.15, 0.28, 1)
albedo_texture = ExtResource("1_apron_color")
roughness_texture = ExtResource("2_apron_rough")
roughness = 0.9
uv1_scale = Vector3(8, 1.2, 1)

[node name="Ring" type="Node3D"]
position = Vector3(0, -0.1, 0)

