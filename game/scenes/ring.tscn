[gd_scene load_steps=10 format=3]

[ext_resource type="Texture2D" path="res://assets/environment/materials/Fabric063_Color.jpg" id="1_apron_color"]
[ext_resource type="Texture2D" path="res://assets/environment/materials/Fabric063_Roughness.jpg" id="2_apron_rough"]
[ext_resource type="Texture2D" path="res://assets/environment/materials/ring_apron_banner.png" id="4_apron_banner"]
[ext_resource type="Script" path="res://core/ring/ring_builder.gd" id="3_ring_builder"]

[sub_resource type="BoxShape3D" id="BoxShape3D_floor"]
size = Vector3(6, 0.2, 6)

[sub_resource type="BoxMesh" id="BoxMesh_floor"]
size = Vector3(6, 0.2, 6)

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_floor"]
; The stand-in the mat wears before RingBuilder re-meshes this node, and what
; test_wrestler_colorway.gd reads. Near-white and near-neutral now, matching
; gauntlet/refs/ring.md's unbranded canvas rather than the blue it carried.
;
; The measured relationship it exists to serve is unchanged: on
; frames/wide_standoff_broadcast_angle.jpg the mat renders at relative
; luminance 0.46 with both wrestlers 0.24-0.31 below it (VISUAL_BAR.md). Our
; own build measured 0.359 before this round -- BELOW its own anchor, which
; also capped the wrestler deltas at 0.208/0.199. A white canvas raises that
; ceiling, so matching the reference and serving the measurement point the
; same way here.
albedo_color = Color(0.975, 0.975, 0.972, 1)
roughness = 0.85

[sub_resource type="BoxShape3D" id="BoxShape3D_rope"]
size = Vector3(6.2, 8.0, 0.3)

; A QUAD, NOT A BOX, and that is the fix for the banner being cropped.
;
; Godot's BoxMesh unwraps its six faces into a 3x2 atlas, so the outward face
; sampled u=[0.000..0.333] v=[0.000..0.500] -- the left third and top half of
; the artwork. The AEW mark sits in the centre of the banner and the right-hand
; TNT roundel at its far edge, so both were outside that window entirely. The
; uv1_scale x=2 below then stretched the crop to u=[0..0.667] rather than
; fixing it, which is why the apron read as a sliver of the supplied image.
;
; A QuadMesh has one face with clean 0..1 UVs, measured rather than assumed:
;   QUAD uv u=[0.000..1.000] v=[0.000..1.000] normal=(0,0,1)
; The 0.1m of thickness the box gave is not missed -- gauntlet/refs/ring.md
; describes a flat hanging skirt, and nothing reads the apron's depth.
[sub_resource type="QuadMesh" id="QuadMesh_apron"]
size = Vector2(6.6, 0.9)

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_apron"]
; The skirt. Flat, dark and NEUTRAL, matching gauntlet/refs/ring.md: the
; reference's apron is an unbranded grey sheet from the mat edge to the floor.
; It carried the ring's blue before, which was itself a fix for an earlier
; problem -- at albedo 0.08 against an arena floor of 0.03 the skirt rendered
; as more void, which is why a slice's gap line said "no ring skirt" about
; geometry that was present.
;
; That fix still has to hold, and it does, because the mechanism was VALUE
; SEPARATION and not colour: the skirt sits between the white mat above it and
; the darker arena floor below it. Going neutral moves its hue, not its place
; in that ordering. What changed alongside it is that the mat above is now
; near-white rather than pale blue, so the separation is wider than it was.
;
; The fabric is CC0 (assets/environment/CREDITS.md). It is here for variance,
; not for value: albedo_color still holds the luminance and the texture
; multiplies into it, so the relationships measure_frame.py reads are the ones
; set here. Material believability is UNJUDGED under llvmpipe either way.
; BRANDED APRON, by direct instruction from the project owner, replacing the
; unbranded grey sheet the paragraphs above describe. The banner supplied
; carries third-party marks (AEW, TNT) -- recorded in
; assets/environment/CREDITS.md rather than left undeclared. ARCHITECTURE.md's
; third-party asset rule permits this; it is not cleared for distribution, and
; that is the owner's call to make, not this file's.
;
; albedo_color goes to white because the banner supplies its own colour now.
; That deliberately gives up the luminance control the old note describes: the
; apron's value is whatever the artwork is, so any VISUAL_BAR figure measured
; off apron pixels moves with it. The mat-vs-skirt value ORDERING that the
; original fix depended on still holds -- the banner is near-black against a
; near-white mat, a wider separation than the 0.105 grey it replaces.
;
; ONE copy per side, mapped 1:1, because the artwork is now a real apron
; graphic rather than a photograph of one.
;
; Everything that used to stand here -- a long derivation of a 1.48x zoom, a
; brightness-weighted centroid, a fixed 2.0681 no-distortion ratio and a pair
; of clamped edge columns sampled to prove they were near-black cloth -- was
; solving a problem this file no longer has. The old banner was a crop with
; wide dark margins and the marks adrift in the middle of it, so it had to be
; zoomed into and re-centred, and the skirt either side of the zoom had to be
; faked by clamping.
;
; The supplied graphic is the apron itself: art edge to edge, the AEW block and
; DYNAMITE wordmark already centred, and the chevron bursts at both ends that
; wrap a real apron round its corners. There is nothing to crop to and nothing
; to centre -- scale 1, offset 0, and the whole design lands on the side.
;
; It is stretched 13% vertically and that is deliberate. The graphic is 8.32:1
; and an apron face is 6.6m x 0.9m, 7.33:1. Holding the proportions instead
; would mean cropping 13% of the WIDTH, and the width is where the chevron
; ends are -- so the choice is a slightly squat wordmark or an apron with its
; corner wraps cut off. The stretch is the smaller loss and it is invisible at
; every distance the shotlist frames the ring from.
;
; texture_repeat stays OFF: with scale 1 and offset 0 the sampled range is
; exactly 0..1, so nothing clamps and nothing tiles, but leaving it off means
; a later UV tweak that strays outside that range extends the edge rather than
; wrapping the far chevron round onto the near corner.
;
; The CC0 fabric roughness map stays: it is the only thing keeping the surface
; from reading as flat vinyl, and it carries no colour.
albedo_color = Color(1, 1, 1, 1)
albedo_texture = ExtResource("4_apron_banner")
roughness_texture = ExtResource("2_apron_rough")
roughness = 0.9
texture_repeat = false
uv1_scale = Vector3(1, 1, 1)
uv1_offset = Vector3(0, 0, 0)

[node name="Ring" type="Node3D"]
position = Vector3(0, -0.1, 0)

[node name="Apron" type="Node3D" parent="."]

[node name="ApronNorth" type="MeshInstance3D" parent="Apron"]
mesh = SubResource("QuadMesh_apron")
surface_material_override/0 = SubResource("StandardMaterial3D_apron")
position = Vector3(0, -0.55, 3.15)

[node name="ApronSouth" type="MeshInstance3D" parent="Apron"]
mesh = SubResource("QuadMesh_apron")
surface_material_override/0 = SubResource("StandardMaterial3D_apron")
position = Vector3(0, -0.55, -3.15)
rotation = Vector3(0, 3.14159, 0)

[node name="ApronEast" type="MeshInstance3D" parent="Apron"]
mesh = SubResource("QuadMesh_apron")
surface_material_override/0 = SubResource("StandardMaterial3D_apron")
position = Vector3(3.15, -0.55, 0)
rotation = Vector3(0, 1.5708, 0)

; -1.5708, not +1.5708. Both East and West carried +1.5708 when these were
; boxes, which was harmless because a box draws all six faces. A quad has one,
; so West would have faced into the ring and rendered as a hole from outside.
[node name="ApronWest" type="MeshInstance3D" parent="Apron"]
mesh = SubResource("QuadMesh_apron")
surface_material_override/0 = SubResource("StandardMaterial3D_apron")
position = Vector3(-3.15, -0.55, 0)
rotation = Vector3(0, -1.5708, 0)

[node name="Floor" type="StaticBody3D" parent="."]

[node name="CollisionShape3D" type="CollisionShape3D" parent="Floor"]
shape = SubResource("BoxShape3D_floor")

[node name="MeshInstance3D" type="MeshInstance3D" parent="Floor"]
mesh = SubResource("BoxMesh_floor")
surface_material_override/0 = SubResource("StandardMaterial3D_floor")

[node name="RopeCollisionNorth" type="StaticBody3D" parent="." groups=["ring_ropes"]]
position = Vector3(0, 0.85, 3.1)

[node name="CollisionShape3D" type="CollisionShape3D" parent="RopeCollisionNorth"]
shape = SubResource("BoxShape3D_rope")

[node name="RopeCollisionSouth" type="StaticBody3D" parent="." groups=["ring_ropes"]]
position = Vector3(0, 0.85, -3.1)

[node name="CollisionShape3D" type="CollisionShape3D" parent="RopeCollisionSouth"]
shape = SubResource("BoxShape3D_rope")

[node name="RopeCollisionEast" type="StaticBody3D" parent="." groups=["ring_ropes"]]
position = Vector3(3.1, 0.85, 0)
rotation = Vector3(0, 1.5708, 0)

[node name="CollisionShape3D" type="CollisionShape3D" parent="RopeCollisionEast"]
shape = SubResource("BoxShape3D_rope")

[node name="RopeCollisionWest" type="StaticBody3D" parent="." groups=["ring_ropes"]]
position = Vector3(-3.1, 0.85, 0)
rotation = Vector3(0, 1.5708, 0)

[node name="CollisionShape3D" type="CollisionShape3D" parent="RopeCollisionWest"]
shape = SubResource("BoxShape3D_rope")

; Everything cosmetic about the ring -- canvas, ropes, turnbuckle fittings,
; posts, apron frame, steel steps -- is generated by this, for the reasons its
; own header gives. What stays authored here is exactly what is NOT cosmetic:
; Floor/CollisionShape3D, the four RopeCollision* bodies in the group
; "ring_ropes" that wrestler_controller.gd bounces off, and
; Floor/MeshInstance3D, whose node path capture_harness.gd keys blue for the
; silhouette mask and test_wrestler_colorway.gd reads the mat's albedo from.
; The builder re-meshes that node in place; it never renames or reparents it.
[node name="RingBuilder" type="Node3D" parent="."]
script = ExtResource("3_ring_builder")
