[node name="WrestlerA" parent="." instance=ExtResource("3")]
; Squared up along Z, not X. The broadcast camera is anchored west and looks
; up +X, so wrestlers separated along X sat one behind the other -- near and
; far, not left and right. Rotating the pair 90 degrees puts them across the
; frame where a stare-down belongs. This is the authored spawn only; nothing
; in the match loop depends on which axis they start on.
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -1.5)
player_index = 0
is_ai = false
attire_body = Color(0.42, 0.6, 0.95, 1)
