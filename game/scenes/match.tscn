[sub_resource type="Environment" id="Environment_arena"]
background_mode = 1
background_color = Color(0.02, 0.02, 0.025, 1)
ambient_light_source = 2
ambient_light_color = Color(0.5, 0.55, 0.68, 1)
; Ambient was 0.35 and it was the rig. Ambient is direction-blind: it lands the
; same on a horizontal mat and on a standing torso, so under it a wrestler and
; the mat render at the ratio of their ALBEDOS and nothing else. That is
; exactly what measure_silhouette.py was reporting -- mat<->wrestler 0.094 and
; 0.044 against VISUAL_BAR.md's 0.24-0.31. Cutting ambient to a bounce floor
; and putting the level into the truss fixtures is what makes the gap exist at
; all; the top-down key is the only thing in the scene that can tell a floor
; from a chest.
ambient_light_energy = 0.06
; --- Tonemap ---------------------------------------------------------------
; Filmic (2) rather than the default Linear (0). VISUAL_BAR.md's mat figure is
; an EXPOSURE ANCHOR, which only means something once there is an exposure to
; set: with a linear tonemap the only way to reach mat 0.46 is to push the
; whole scene up until the ropes and the apron clip, and compare_frame.py sees
; that as highlights that are bright but structureless. A shoulder is what
; lets the mat sit at 0.46 while the ropes stay above it and still separate.
; Filmic over ACES: ACES desaturates its top end hardest, and mean_saturation
; is already 0.218 against the reference's 0.306 -- ACES would widen the gap
; this project is trying to close.
tonemap_mode = 2
; White point. Sets where the shoulder puts pure white, and therefore how much
; of the curve the mat's 0.46 sits on. 2.0 keeps the mat on the near-linear
; part while leaving a stop of headroom above it for the ropes and the fixture
; cones. Coverage decision: gauntlet/refs/ measures no white point.
tonemap_white = 2.0
tonemap_exposure = 1.0
; --- Glow ------------------------------------------------------------------
; Threshold above 1.0 so only genuinely over-range things bloom -- the video
; wall, the fixture cones in the haze, the top of the ropes. Broadcast light
; through arena air is the look this is after; a low threshold instead just
; puts a halo on everything and costs local contrast, which is already
; 0.884 against the reference's 0.816 (i.e. ours is too contrasty, not too
; little).
glow_enabled = true
glow_normalized = true
glow_intensity = 0.35
glow_strength = 1.0
glow_bloom = 0.05
glow_blend_mode = 0
glow_hdr_threshold = 1.25
glow_hdr_scale = 2.0
; --- Ambient occlusion -----------------------------------------------------
; With ambient down at a bounce floor, contact darkening has to come from
; somewhere; SSAO is what keeps the wrestlers' feet joined to the mat and the
; seats joined to the risers now that neither is self-emissive.
ssao_enabled = true
ssao_radius = 0.75
ssao_intensity = 1.7
ssao_power = 1.4
ssao_detail = 0.6
ssao_light_affect = 0.12
ssao_ao_channel_affect = 0.2
; SSIL and SDFGI are deliberately OFF, and this is not a cost argument -- no
; software capture may make one (ARCHITECTURE.md). Both accumulate over
; frames, and CaptureHarness.ART_SETTLE_FRAMES is 3 while SILHOUETTE_SETTLE is
; 90. An effect that has converged in one measurement and not the other makes
; the two disagree about the same scene, which would poison the exposure
; anchor the whole slice is judged on.
; --- Volumetric fog --------------------------------------------------------
; The light shafts. The key fixtures carry light_volumetric_fog_energy, so the
; four truss cones become visible volumes of air over the ring instead of
; invisible vectors that only exist where they land. Global density is low;
; ArenaLighting adds two FogVolumes for the local concentration.
volumetric_fog_enabled = true
volumetric_fog_density = 0.0015
volumetric_fog_albedo = Color(0.72, 0.77, 0.9, 1)
volumetric_fog_anisotropy = 0.35
volumetric_fog_length = 64.0
volumetric_fog_detail_spread = 2.0
volumetric_fog_gi_inject = 0.0
volumetric_fog_ambient_inject = 0.0
volumetric_fog_sky_affect = 0.0
; Temporal reprojection off for the same reason SSIL is off: it converges over
; frames and the two shot modes settle for different numbers of them.
volumetric_fog_temporal_reprojection_enabled = false
; --- Grade -----------------------------------------------------------------
; A small saturation lift against the tonemap's own desaturation.
; mean_saturation 0.218 vs the reference's 0.306 (compare_frame.py).
adjustment_enabled = true
adjustment_brightness = 1.0
adjustment_contrast = 1.0
adjustment_saturation = 1.22

