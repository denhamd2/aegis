physique_bulk = 0.94
body_variant = 0
physique_height = 0.98
torso_width = 1.0
attire_accent = Color(0.46, 0.72, 1, 1)
strike_move = ExtResource("7")
grapple_move = ExtResource("15")
signature_move = ExtResource("9")
running_attack_move = ExtResource("13")
running_attack_move_pool = Array[Resource]([ExtResource("30")])
strike_move_pool = Array[Resource]([ExtResource("29"), ExtResource("33"), ExtResource("34")])
grapple_move_pool = Array[Resource]([ExtResource("15")])
signature_move_pool = Array[Resource]([ExtResource("21")])
