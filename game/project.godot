[physics]

common/physics_ticks_per_second=60
common/physics_jitter_fix=0.0
common/physics_interpolation=true
common/enable_pause_aware_picking=true
3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="forward_plus"
; The Mac build (export_presets.cfg "macOS") is the full desktop look: pinned
; to forward_plus (Metal) so it can never fall back to the Web build's
; compatibility renderer.
renderer/rendering_method.macos="forward_plus"
renderer/rendering_method.mobile="mobile"
; Apple Silicon Macs read the ETC2/ASTC formats as well as the desktop ones;
; the universal macOS app ships both.
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.1, 0.1, 0.12, 1)
; ArenaLighting builds 22 fixtures and the OpenGL default is 8 lights per
; object, so on the compatibility renderer the mat was lit by whichever 8 the
; renderer picked -- and it did not pick the four truss keys hanging directly
; over it. Measured on the silhouette standoff, mat relative luminance:
;
;   forward_plus                          0.456   (anchor 0.43-0.49)
;   gl_compatibility, limit 8             0.003
;   gl_compatibility, only 6 fixtures up  0.995   <- proof the lights are fine
;
; That last row is the diagnostic: hiding all but the keys and top fills puts
; the mat at 0.995, so nothing was wrong with the fixtures or their energies.
; The renderer was dropping them. Raising the limit is the fix; energy gain
; and tonemap exposure were both tried first and are both wrong, because they
; scale the emissive hall (ArenaBuilder._house_lit) along with the lit ring.
;
; This key is under limits/opengl and Vulkan ignores it, so forward_plus --
; where every measured number in gauntlet/ was taken -- cannot be affected.
limits/opengl/max_lights_per_object=32
; Anti-aliasing (gauntlet/refs/aaa_gap.md, item 1). There was none at all, and
; the stair-stepped edges on hair, ropes and shoulders were the loudest
; not-AAA tell in the owner's screenshots. MSAA 4x resolves geometry edges and
; -- through alpha to coverage on the hair cards and shells -- strand edges;
; TAA takes the shimmer out of the thin, high-contrast lines MSAA alone leaves
; crawling in motion (ropes against the dark hall, the crowd cards).
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_taa=true
; Skin scattering (SkinLook): medium quality, the default is the lowest.
environment/subsurface_scattering/subsurface_scattering_quality=2

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
; Opens maximized, fitted to the screen: a fixed 1920x1080 window is taller
; than a laptop's display, and on the owner's Mac the bottom of it -- the
; HUD's health plates -- was off the bottom of the screen.
window/size/mode=2
window/size/window_width_override=1600
window/size/window_height_override=900
; Landscape on a phone, either way up.
window/handheld/orientation=4

[shader_globals]

glint_strength={
"type": "float",
"value": 0.3
}
crowd_light={
"type": "float",
"value": 1.0
}
crowd_excitement={
"type": "float",
"value": 0.0
}
crowd_flash_rate={
"type": "float",
"value": 0.0
}
