; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Aegis"
config/description="Original 3D wrestling vertical slice — Gauntlet Loop build."
run/main_scene="res://scenes/match.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

ReplaySystem="*res://core/replay/replay_system.gd"
CaptureHarness="*res://core/capture/capture_harness.gd"

