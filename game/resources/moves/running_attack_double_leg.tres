[gd_resource type="Resource" script_class="MoveDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://resources/move_def.gd" id="1"]

[resource]
script = ExtResource("1")
; Second running attack. Frame data mirrors the clothesline and damage totals
; match it (16) with a takedown distribution, so this adds variety without
; moving any balance number.
;
; It has NO clip of its own, and that is deliberate: the baked double-leg
; excerpt it used to name rendered as a ball of limbs (head below hips on 59
; of 69 frames) and could not be re-baked -- see resources/animations/
; strike_recipes.gd. An empty pair id falls back to STATE_ANIMATIONS'
; RUNNING_ATTACK clip, which is exactly what running_attack_clothesline.tres
; already does. The two running attacks therefore differ in damage
; distribution but not yet in performance.
animation_pair_id = &""
startup_frames = 18
active_frames = 5
recovery_frames = 46
reversal_window_start = 7
reversal_window_end = 12
damage_head = 2.0
damage_torso = 8.0
damage_arms = 0.0
damage_legs = 6.0
momentum_cost = 0.0
momentum_gain = 10.0
weight_class_min = 0
weight_class_max = 2
required_opponent_state = -1
